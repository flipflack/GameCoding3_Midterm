<<if $suspiciousGuy_DialoguePhase == "QuestIntroduction">>
<<jump SuspiciousGuy_QuestIntroduction>>
<<elseif $suspiciousGuy_DialoguePhase == "QuestCompleted">>
<<jump SuspiciousGuy_QuestCompleted>>
<<elseif $suspiciousGuy_DialoguePhase == "QuestFumbled">>
<<jump SuspiciousGuy_QuestFumbled>>
<<endif>>
